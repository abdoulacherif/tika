<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎬 Mes enregistrements"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selectModeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sélectionner"
            android:textColor="#B388FF"
            android:textSize="13sp"
            android:padding="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aucune vidéo pour le moment"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="40dp" />

    <ListView
        android:id="@+id/videoListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <LinearLayout
        android:id="@+id/mergeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_stat_purple"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectionCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 sélectionnée(s)"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/mergeConfirmButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fusionner"
            android:textAllCaps="false"
            android:background="@drawable/bg_card"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>