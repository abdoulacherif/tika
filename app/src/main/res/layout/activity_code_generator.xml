<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐 Générateur de codes"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Durée de Pro accordée"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/durationGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <RadioButton android:id="@+id/dur30" android:text="30 jours" android:textColor="#FFFFFF" android:checked="true" />
            <RadioButton android:id="@+id/dur90" android:text="90 jours" android:textColor="#FFFFFF" />
            <RadioButton android:id="@+id/dur365" android:text="365 jours" android:textColor="#FFFFFF" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Le code doit être utilisé avant"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/validityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <RadioButton android:id="@+id/valid7" android:text="7 jours" android:textColor="#FFFFFF" android:checked="true" />
            <RadioButton android:id="@+id/valid14" android:text="14 jours" android:textColor="#FFFFFF" />
            <RadioButton android:id="@+id/valid30" android:text="30 jours" android:textColor="#FFFFFF" />
        </RadioGroup>

        <Button
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:text="Générer un code" />

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code généré :"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/generatedCodeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B388FF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/copyCodeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_purple"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:text="📋 Copier"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>