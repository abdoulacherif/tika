<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_screen"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 Localiser mon téléphone"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Position actuelle enregistrée à chaque ouverture"
        android:textColor="#9E9E9E"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_stat_blue"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/coordinatesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recherche en cours…"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updatedAtText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D6EBFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/openMapsButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:text="🗺️ Ouvrir dans Google Maps"
        android:enabled="false"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/refreshLocationButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_card"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:text="🔄 Actualiser ma position" />

    <TextView
        android:id="@+id/deviceIdText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#666666"
        android:textSize="11sp"
        android:layout_marginTop="24dp" />

</LinearLayout>